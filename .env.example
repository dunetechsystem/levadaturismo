# API do DunasTour — chamada SOMENTE pelo servidor do Next (o IP do servidor precisa estar liberado no backend).
DUNASTOUR_API_URL=https://api.dunastour.com.br
# Slug da agência no DunasTour (dunastour.com.br/<slug>).
DUNASTOUR_AGENCY_SLUG=levada-turismo
# URL pública deste site (SEO / Open Graph).
NEXT_PUBLIC_SITE_URL=https://levadaturismo.com

# Rastreamento (tráfego pago). Deixe vazio o que não usar — sem ID, o script nem carrega.
# Use OU os IDs diretos OU o GTM com as tags dentro dele, pra não contar em dobro.
# Meta (Facebook/Instagram) — Gerenciador de Eventos → Conjunto de dados → ID.
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 — "G-XXXXXXX".
NEXT_PUBLIC_GA4_ID=
# Google Ads — "AW-123456789" e o rótulo da ação de conversão "Lead" (o que vem depois da barra).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Google Tag Manager — "GTM-XXXXXXX" (opcional; recebe os eventos levada_* no dataLayer).
NEXT_PUBLIC_GTM_ID=
